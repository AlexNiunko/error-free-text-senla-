<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3-create-task-error-table" author="AlexNiunko">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="task_error"/>
            </not>
        </preConditions>

        <createTable tableName="task_error" schemaName="public">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_task_error"/>
            </column>
            <column name="created_at" type="timestamp(6)" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp(6)" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="task_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_task_error_task"
                             referencedTableName="task"
                             referencedColumnNames="id"/>
            </column>
        </createTable>

        <createIndex tableName="task_error" indexName="idx_task_error_task_id">
            <column name="task_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="task_error" indexName="idx_task_error_task_id"/>
            <dropTable tableName="task_error"/>
        </rollback>
    </changeSet>

</databaseChangeLog>